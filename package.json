{
  "name": "jsontotables",
  "version": "1.0.0",
  "type": "module",
  "description": "Convert JSON to Markdown, TSV, plaintext, or HTML tables. Ideal for docs, reports, and React UIs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react-index.js",
      "types": "./dist/react-index.d.ts"
    }
  },
  "bin": {
    "jsontotables": "dist/bin/cli.js"
  },
  "files": [
  "dist/",
  "README.md",
  "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonyhalim150/jsontotables.git"
  },
  "keywords": [
    "json",
    "json to table",
    "json to markdown",
    "markdown table",
    "tsv",
    "html table",
    "react table",
    "cli tool",
    "cli",
    "library",
    "table generator",
    "typescript library",
    "data to table",
    "json viewer"
  ],
  "author": "anthonyhalim150",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitest/coverage-v8": "^3.1.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
